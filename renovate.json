{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.txt$/"],
      "matchStrings": ["(?<depName>\\S+)==(?<currentValue>\\S+)"],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["jsonata", "npmm"],
      "labels": ["custom-regex"]
    }
  ]
}
